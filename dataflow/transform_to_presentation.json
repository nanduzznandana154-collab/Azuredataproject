{
	"name": "transform_to_presentation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Json_Ingested",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Json_presentation",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "flattenRaces"
				}
			],
			"scriptLines": [
				"source(output(",
				"          MRData as (RaceTable as (Races as (Circuit as (Location as (country as string, lat as double, locality as string, long as double), circuitId as string, circuitName as string, url as string), date as date, raceName as string, round as short, season as short, url as string)[]), limit as short, offset as boolean, series as string, total as short, url as string, xmlns as string)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> source1",
				"flattenRaces select(mapColumn(",
				"          Circuit,",
				"          date,",
				"          raceName,",
				"          round,",
				"          season,",
				"          raceUrl,",
				"          limit,",
				"          offset,",
				"          series,",
				"          total,",
				"          apiUrl,",
				"          xmlns",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"source1 foldDown(unroll(MRData.RaceTable.Races),",
				"     mapColumn(",
				"          Circuit = MRData.RaceTable.Races.Circuit,",
				"          date = MRData.RaceTable.Races.date,",
				"          raceName = MRData.RaceTable.Races.raceName,",
				"          round = MRData.RaceTable.Races.round,",
				"          season = MRData.RaceTable.Races.season,",
				"          raceUrl = MRData.RaceTable.Races.url,",
				"          limit = MRData.limit,",
				"          offset = MRData.offset,",
				"          series = MRData.series,",
				"          total = MRData.total,",
				"          apiUrl = MRData.url,",
				"          xmlns = MRData.xmlns",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenRaces",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Circuit,",
				"          date,",
				"          raceName,",
				"          round,",
				"          season,",
				"          raceUrl,",
				"          limit,",
				"          offset,",
				"          series,",
				"          total,",
				"          apiUrl,",
				"          xmlns",
				"     )) ~> sink1"
			]
		}
	}
}